# Copie para .env e preencha. Serve para os dois arquivos do Docker Compose:
#   docker-compose.yml       desenvolvimento local (tudo tem padrao, so ajuste se quiser)
#   docker-compose.prod.yml  producao num servidor proprio (preencha a secao "Producao")
# No EasyPanel e paineis parecidos, as mesmas variaveis vao no painel. Ver docs/INSTALACAO.md.

# ---------------------------------------------------------------- Banco de dados
POSTGRES_USER=servirmais
# Senha forte: openssl rand -hex 24
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=designacoes

# ---------------------------------------------------------------- API
# OBRIGATORIO. Segredo que assina os logins. Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-forte-aleatorio
# Senha do usuario "admin" criado no primeiro boot. Vazio = o servidor gera uma aleatoria e
# mostra no log uma unica vez. Troque no primeiro acesso.
ADMIN_SEED_PASSWORD=
# Senha que o admin da a quem ele cria ou redefine. Vazio = jw1010. Como o codigo e publico,
# troque por uma sua.
SENHA_PADRAO=
# Fuso da congregacao (lembretes e saudacoes). Lista: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
FUSO_HORARIO=America/Sao_Paulo
# 'false' desliga os lembretes push. Em producao deixe vazio (ligado).
LEMBRETES_ATIVOS=false

# Integracao com o Zoom (opcional): app Server-to-Server OAuth no Zoom App Marketplace.
# Webhook: https://<API_DOMAIN>/api/integrations/zoom/webhook (ver backend/.env.example).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# ---------------------------------------------------------------- Producao (docker-compose.prod.yml)
# Dominios ja apontados (registro A) para o IP do servidor.
API_DOMAIN=api.minhacongregacao.com.br
WEB_DOMAIN=minhacongregacao.com.br

# ---------------------------------------------------------------- Desenvolvimento (docker-compose.yml)
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001
