# Configuração do app da SUA congregação. Copie para mobile/.env e preencha.
# Detalhes em docs/APP.md. Nada aqui é segredo, mas o .env não vai para o Git.

# Nome que aparece embaixo do ícone do app.
APP_NAME=Servir Mais

# Identificador único do app (iOS bundle id e Android package). Use um domínio seu ao
# contrário, só letras minúsculas, números e pontos. Não mude depois de distribuir o app:
# para o celular, outro identificador é outro app.
APP_ID=com.minhacongregacao.servirmais

# URL PÚBLICA do backend (a sua API). Celular não enxerga o "localhost" do computador:
# para testar com a API local use o IP da rede, ex.: http://192.168.0.10:3001
EXPO_PUBLIC_API_URL=https://api.minhacongregacao.com.br

# Conta e projeto no expo.dev (gratuito). Rode `npx eas-cli init` uma vez: ele cria o
# projeto e mostra o id. Necessário para gerar o APK com o EAS e para as notificações push.
EXPO_OWNER=
EAS_PROJECT_ID=

# Opcional: caminho do google-services.json do Firebase (push no Android). Sem ele o app
# funciona normalmente, só não recebe notificações no Android.
# GOOGLE_SERVICES_JSON=./google-services.json
