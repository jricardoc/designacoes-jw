{
  "expo": {
    "name": "Servir Mais",
    "slug": "servir-mais",
    "version": "2.12.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "designacoesjw",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#F3EDE2",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.exemplo.servirmais",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.exemplo.servirmais",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-bg.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "backgroundColor": "#5E6A46"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5E6A46"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que o $(PRODUCT_NAME) use o Face ID para você entrar sem digitar a senha."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o $(PRODUCT_NAME) acesse suas fotos para a foto de perfil.",
          "cameraPermission": "Permitir que o $(PRODUCT_NAME) use a câmera para tirar a foto de perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que o $(PRODUCT_NAME) use sua localização para marcar pontos no mapa do território."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
