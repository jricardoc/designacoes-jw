FROM node:20-alpine
WORKDIR /app
COPY package*.json ./

# AJUSTE: Removi o --production para garantir que ferramentas de build/TS instalem
RUN npm install 

COPY . .
RUN npx prisma generate
EXPOSE 3001
# Aplica as migrations versionadas de prisma/migrations e sobe a API.
#
# Antes isto era `prisma db push`, que INFERE a mudanca comparando schema e banco no boot.
# O problema: ele recusa o que julga arriscado - criar uma constraint UNIQUE, por exemplo -
# e, como tudo estava encadeado com `&&`, o `npm start` nunca era alcancado. O container
# entrava em loop de reinicio e a API ficava 100% fora do ar por causa de uma alteracao de
# schema aditiva. Foi o que aconteceu ao adicionar `Usuario.irmaoId @unique`.
#
# `migrate deploy` aplica apenas migrations ja revisadas e versionadas no repositorio: nao
# infere nada, nao pergunta nada, e falha alto se houver divergencia real.
#
# O `|| echo` continua de proposito: se uma migration falhar, o servidor sobe mesmo assim
# com um aviso em destaque no log. Uma coluna faltando degrada um endpoint; um crash loop
# derruba o sistema inteiro.
#
# Ao mudar o schema: `npx prisma migrate dev --name descricao` em desenvolvimento, e
# commitar a pasta prisma/migrations junto.
CMD ["sh", "-c", "{ npx prisma migrate deploy || echo '>>> AVISO: prisma migrate deploy FALHOU. O schema do banco pode estar desatualizado. Rode `npx prisma migrate status` para investigar. <<<'; } && npm start"]