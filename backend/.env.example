# Backend (Node/Express/Prisma). Copie para backend/.env para rodar fora do Docker.
# Em producao (EasyPanel, docker-compose.prod.yml), configure no painel / no .env da raiz.

# Conexao com o PostgreSQL
DATABASE_URL=postgres://servirmais:senha@localhost:5432/designacoes

# OBRIGATORIO: sem isso o servidor nao inicia. Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-forte-aleatorio

# Origem(ns) do painel web liberada(s) no CORS, separadas por virgula
FRONTEND_URL=http://localhost:5173

# Senha do "admin" criado no primeiro boot. Vazio = aleatoria, mostrada no log uma vez.
ADMIN_SEED_PASSWORD=

# Senha dada a quem o admin cria ou redefine. Vazio = jw1010 (troque: o codigo e publico).
SENHA_PADRAO=

# Fuso da congregacao (lembretes e saudacoes). Padrao: America/Sao_Paulo
FUSO_HORARIO=America/Sao_Paulo

# Opcionais: porta (3001), validade do login (7d) e lembretes push ('false' desliga)
PORT=3001
JWT_EXPIRES_IN=7d
LEMBRETES_ATIVOS=false
