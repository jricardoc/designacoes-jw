generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Quadro de Designacoes Mensal (um por mes/ano)
model Quadro {
  id             Int          @id @default(autoincrement())
  mes            Int // 1-12
  ano            Int // 2026
  titulo         String // "Quadro de Designacoes JANEIRO 2026"
  status         String       @default("rascunho") // rascunho, publicado, arquivado
  // QUANDO e por QUEM o quadro foi publicado.
  //
  // Existe para o painel de tarefas medir se o quadro saiu no prazo — `updatedAt` nao serve
  // (muda a cada edicao de celula) e `status` sozinho so diz que saiu, nao quando. Para os
  // quadros ja publicados antes desta coluna existir, `scripts/backfillPublicacoes.js`
  // preenche a partir do Historico, que ja registrava a acao "publicou".
  publicadoEm    DateTime?
  publicadoPorId Int?
  publicadoPor   Usuario?     @relation("QuadrosPublicados", fields: [publicadoPorId], references: [id], onDelete: SetNull)
  designacoes    Designacao[]
  historicos     Historico[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([mes, ano])
}

// Designacoes pertencem a um Quadro especifico
model Designacao {
  id        Int      @id @default(autoincrement())
  quadroId  Int
  quadro    Quadro   @relation(fields: [quadroId], references: [id], onDelete: Cascade)
  data      String
  dia       String
  funcao    String
  irmao1    String
  irmao2    String
  // Cumprimento da participacao (um por irmao da linha): null = ainda nao
  // avaliado, true = cumpriu, false = faltou. Vive NA designacao de proposito —
  // trocar o irmao da celula ou excluir o quadro descarta a avaliacao junto.
  cumpriu1  Boolean?
  cumpriu2  Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Historico de todas as modificacoes
model Historico {
  id             Int      @id @default(autoincrement())
  quadroId       Int
  quadro         Quadro   @relation(fields: [quadroId], references: [id], onDelete: Cascade)
  usuarioId      Int?
  usuario        Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  acao           String // "criou", "editou", "excluiu", "publicou", "arquivou"
  descricao      String // Descricao legivel
  campo          String? // Campo modificado (irmao1, irmao2, data, dia)
  valorAntigo    String? // Valor anterior
  valorNovo      String? // Novo valor
  designacaoInfo String? // Info da designacao (data + funcao)
  createdAt      DateTime @default(now())
}

// Configuracoes gerais do sistema
model Config {
  id                Int      @id @default(autoincrement())
  titulo            String
  subtitulo         String
  mes               String
  // Horario em que a reuniao comeca, "HH:MM" no fuso da congregacao. E o que torna possivel
  // um lembrete "3 horas antes": a designacao guarda so a data, entao sem isto nao existe
  // instante nenhum de onde subtrair as horas.
  horaMeioSemana    String   @default("19:30")
  horaFimDeSemana   String   @default("09:00")
  // Dados do Zoom que entram nos convites: { meio: {link, id, senha, salaAberta}, fds: {...} }.
  // No banco, e nao no codigo, para cada congregacao preencher os seus pela tela de Ajustes
  // (e para link e senha nao irem parar num repositorio publico).
  zoom              Json?
  // Cor de cada area de territorios no mapa geral: { "Tokaia": "#E53935" }. A area em si e o
  // campo `area` do Territorio; aqui so o que nao cabe nele.
  coresAreas        Json?
  // Limite do territorio da congregacao, importado de um KML: { nome, cor, pontos: [[lat, lng]] }.
  // No banco, e nao no repositorio, porque e dado de cada congregacao.
  limiteTerritorio  Json?
  // Onde instalar o app: { android: {url, versao, em}, ios: {...} }. Preenchido sozinho pelo
  // webhook do EAS quando um build de preview termina; /download/:plataforma redireciona para ca.
  linksDownload     Json?
  // O secretario da congregacao (id do Irmao): ve todos os grupos e o relatorio de campo, e e
  // avisado quando cada grupo conclui. Escolhido pelo admin geral na tela de Grupos.
  secretarioIrmaoId Int?
  updatedAt         DateTime @updatedAt
}

// Usuario para autenticacao (login por nickname)
model Usuario {
  id                   Int                     @id @default(autoincrement())
  nickname             String                  @unique
  senha                String
  nome                 String
  // Admin GERAL: contempla tudo. Continua sendo o campo historico — nao foi
  // convertido em escopo para nao precisar migrar dado de usuario ja existente
  // num banco em producao (o EasyPanel roda `db push`, que nao move dado).
  isAdmin              Boolean                 @default(false)
  // Escopos de admin por area, para quem NAO e admin geral. Um usuario pode ter
  // varios. Valores validos em src/middleware/escopos.js.
  // Aditivo com default: seguro para o `db push` do deploy.
  escopos              String[]                @default([])
  // Vinculo com o cadastro da congregacao. E o que permite ao irmao ver as proprias
  // designacoes: sem ele so restaria casar por nome, que falha em silencio quando o nome do
  // login difere do cadastro ("Hugo D. Almeida" vs "Hugo Almeida").
  // @unique: uma conta por irmao. SetNull para que excluir um irmao nao apague a conta.
  irmaoId              Int?                    @unique
  irmao                Irmao?                  @relation(fields: [irmaoId], references: [id], onDelete: SetNull)
  historicos           Historico[]
  pushTokens           PushToken[]
  prefNotificacao      PreferenciaNotificacao?
  notificacoesEnviadas NotificacaoEnviada[]
  // As tarefas de sistema que o admin geral atribuiu a ele, e as ocorrencias que ele ja
  // deu por cumpridas. Ficam FORA de `escopos` de proposito: escopo diz onde a pessoa
  // PODE mexer, tarefa diz o que ela DEVE fazer — quem compartilha o link do Zoom nao
  // precisa administrar area nenhuma.
  tarefas              TarefaDesignada[]
  tarefasConcluidas    TarefaConcluida[]
  quadrosPublicados    Quadro[]                @relation("QuadrosPublicados")
  escalasPublicadas    QuadroDirigente[]       @relation("EscalasPublicadas")
  // Quando a foto de perfil mudou; null = sem foto. Fica aqui (e a imagem em FotoUsuario)
  // para o app saber se ha foto, e montar a URL com versao, sem carregar os bytes.
  fotoEm               DateTime?
  foto                 FotoUsuario?
  saidasTerritorio     RegistroSaida[]         @relation("SaidasTerritorio")
  marcacoesTerritorio  Marcacao[]              @relation("MarcacoesTerritorio")
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
}

// A foto de perfil (JPEG pequeno, ~30 KB). Tabela propria para nenhuma consulta de usuario
// arrastar os bytes sem querer; no banco, e nao em disco, para a instalacao nao precisar de
// volume e o backup do Postgres ja levar as fotos junto.
model FotoUsuario {
  usuarioId Int      @id
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  imagem    Bytes
  updatedAt DateTime @updatedAt
}

// Cadastro de irmaos com suas funcoes
model Irmao {
  id                    Int                    @id @default(autoincrement())
  nome                  String                 @unique
  funcoes               String[]
  nivelAudioVideo       String                 @default("experiente") // "experiente" ou "treinando"
  // So digitos, com DDD ("71999998888"). Usado para abrir a conversa no WhatsApp ja com o
  // texto da confirmacao. Opcional: quem nao tem numero cadastrado ainda cai no
  // compartilhamento comum, que deixa o irmao escolher o app e o contato.
  telefone              String?
  // "irmao" | "irma". Como se fala com a pessoa, nao sexo biologico — e por isso que os
  // valores tem o nome que tem. Opcional so por causa da transicao: o script de migracao
  // preenche todo mundo, e quem entrar depois preenche na tela de Pessoas.
  genero                String?
  // LEGADO, sem uso. Nasceu como texto livre e durou um commit: renomear um grupo teria de
  // ser feito publicador por publicador, e um erro de digitacao criaria um grupo fantasma.
  // A ligacao correta e `grupoId`, abaixo. A coluna continua aqui porque remove-la trava o
  // boot em producao (o `db push` recusa DROP COLUMN) — sai com um ALTER a mao, quando der.
  grupo                 String?
  grupoId               Int?
  grupoCampo            GrupoCampo?            @relation("GrupoPublicadores", fields: [grupoId], references: [id], onDelete: SetNull)
  // Os grupos que esta pessoa dirige ou ajuda. Lista, e nao campo unico, porque e o Prisma
  // que exige o lado inverso — na pratica e no maximo um de cada.
  gruposQueDirige       GrupoCampo[]           @relation("GrupoDirigente")
  gruposQueAjuda        GrupoCampo[]           @relation("GrupoAjudante")
  // "servoMinisterial", "anciao" ou null (nenhum). Hoje e informativo; a intencao e usar
  // como criterio de designacao no futuro, entao vale guardar mesmo sem regra ligada.
  privilegio            String?
  // "regular" (pioneiro regular) ou null. Separado do privilegio: um servo ministerial pode
  // ser pioneiro regular. O auxiliar e de cada mes e fica no proprio relatorio.
  pioneiro              String?
  ativo                 Boolean                @default(true)
  usuario               Usuario?
  indisponibilidades    Indisponibilidade[]
  dirigenteSaidas       DirigenteSaidaCampo[]
  carrinhoEscalas       CarrinhoEscala[]
  designacoesTerritorio DesignacaoTerritorio[]
  presencasZoom         PresencaZoom[]
  relatoriosCampo       RelatorioCampo[]
  participacoesZoom     ZoomParticipante[]
  pioneiroPerfil        PioneiroPerfil?
  pioneiroHoras         PioneiroHoras[]
  revisitas             Revisita[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

// Grupos de campo da congregacao.
//
// Sao poucos e mudam pouco, mas mudam: grupo e batizado com o nome de quem o dirige, e quando
// a designacao troca o grupo inteiro e renomeado. Por isso e tabela e nao lista fixa no
// codigo — renomear aqui acerta todo mundo de uma vez, e o publicador aponta para o grupo,
// nao para o texto.
//
// E o que liga a pessoa a limpeza do salao: o campo `limpeza` da programacao importada vem
// escrito por grupo ("Grupos 1 Fulano & Grupo 2 Sicrano").
model GrupoCampo {
  id                   Int                 @id @default(autoincrement())
  nome                 String              @unique
  // Ordem de exibicao; empate cai no nome. Serve para a lista nao dancar a cada renomeacao.
  ordem                Int                 @default(0)
  // O numero com que a PROGRAMACAO chama este grupo ("Limpeza: Grupo 4 Evaldo LIma").
  // Nao e a `ordem`: a ordem e de exibicao no app e nada obriga as duas a coincidirem —
  // hoje nao coincidem. Existe porque o nome do grupo no documento chega abreviado e com
  // caixa trocada, e o numero e o unico pedaco estavel; `scripts/vincularLimpeza.js`
  // aprende esse numero a partir do proprio documento. Nulo = casa so por nome.
  numero               Int?
  // Onde o grupo se reune para sair ("Tokaia", "Casa de uma irmã"), como vem na lista de grupos.
  local                String?
  ativo                Boolean             @default(true)
  publicadores         Irmao[]             @relation("GrupoPublicadores")
  relatoriosConcluidos RelatorioGrupoMes[]

  // Dirigente e ajudante moram NO GRUPO, e nao como campo do publicador: o papel e do grupo,
  // e a mesma pessoa pode dirigir um e nao ser nada em outro. Como campo da pessoa, trocar o
  // dirigente exigiria mexer em dois cadastros e nada garantiria que so um e o dirigente.
  //
  // `onDelete: SetNull`: apagar a pessoa nao pode apagar o grupo inteiro junto.
  dirigenteId Int?
  dirigente   Irmao? @relation("GrupoDirigente", fields: [dirigenteId], references: [id], onDelete: SetNull)
  ajudanteId  Int?
  ajudante    Irmao? @relation("GrupoAjudante", fields: [ajudanteId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Datas em que o irmao nao esta disponivel
model Indisponibilidade {
  id        Int      @id @default(autoincrement())
  irmaoId   Int
  irmao     Irmao    @relation(fields: [irmaoId], references: [id], onDelete: Cascade)
  data      String
  motivo    String?
  createdAt DateTime @default(now())

  @@unique([irmaoId, data])
}

// NOVO: Modelos para Reuniões Importadas via Excel
model Reuniao {
  id        Int             @id @default(autoincrement())
  mes       Int // 1-12
  ano       Int // 2026
  semanas   SemanaReuniao[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([mes, ano])
}

model SemanaReuniao {
  id        Int     @id @default(autoincrement())
  reuniaoId Int
  reuniao   Reuniao @relation(fields: [reuniaoId], references: [id], onDelete: Cascade)

  // Dados Gerais da Semana
  faixaData      String // Ex: "Março 02 - 08"
  dataReuniao    String? // Ex: "05/03/2026"
  leituraSemanal String? // Ex: "Ísaias 41 - 42"

  // Cabeçalho / Presidente
  presidente    String?
  conselheiroB  String?
  oracaoInicial String?
  oracaoFinal   String?

  // Canticos e Tempos
  canticoInicial String?
  canticoMeio    String?
  canticoFinal   String?

  // Partes da Reunião (JSON ou campos específicos - usaremos campos para facilitar)
  // Tesouros
  tesouro1_titulo    String?
  tesouro1_irmao     String?
  tesouro2_titulo    String?
  tesouro2_irmao     String?
  tesouro3_titulo    String?
  tesouro3_salaB     String?
  tesouro3_principal String?

  // Ministério
  ministerio1_titulo    String?
  ministerio1_salaB     String?
  ministerio1_principal String?
  ministerio2_titulo    String?
  ministerio2_salaB     String?
  ministerio2_principal String?
  ministerio3_titulo    String?
  ministerio3_salaB     String?
  ministerio3_principal String?
  ministerio4_titulo    String?
  ministerio4_salaB     String?
  ministerio4_principal String?

  // Vida Cristã
  vidaCrista1_titulo String?
  vidaCrista1_irmao  String?
  vidaCrista2_titulo String?
  vidaCrista2_irmao  String?

  // Estudo Bíblico
  estudoBiblico_dirigente String?
  estudoBiblico_leitor    String?

  // Final de Semana
  fds_presidente  String?
  fds_tema        String?
  fds_orador      String?
  fds_congregacao String?
  fds_leitor      String?

  // Designações Mecânicas (Meio de Semana)
  mecanica_audioVideo  String?
  mecanica_indicadores String?
  mecanica_microfone   String?

  // Designações Mecânicas (Final de Semana)
  fds_mecanica_audioVideo  String?
  fds_mecanica_indicadores String?
  fds_mecanica_microfone   String?
  fds_mecanica_portao      String?

  // Limpeza
  limpeza String?

  createdAt DateTime @default(now())
}

// Assistencia (contagem de presentes) de cada reuniao, separada em presencial e
// Zoom. Chaveada pela DATA da reuniao, NAO por SemanaReuniao: reimportar o mes
// apaga e recria as semanas (deleteMany + createMany em ReuniaoController.import,
// ids novos), e o historico de assistencia precisa sobreviver a isso.
model AssistenciaReuniao {
  id            Int            @id @default(autoincrement())
  data          String // "dd/MM/yyyy" — o dia da reuniao contada (meio: a propria; fds: o domingo)
  tipo          String // "meio" | "fds"
  presencial    Int            @default(0)
  zoom          Int            @default(0)
  presencasZoom PresencaZoom[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([data, tipo])
}

// Quem assistiu pelo Zoom numa reuniao: uma linha por conexao. `pessoas` conta a familia no
// mesmo aparelho; a soma e o que se confere com o numero do Zoom em AssistenciaReuniao.
// `nome` e o do cadastro (irmaoId) ou o nome da conexao no Zoom, para visitante.
model PresencaZoom {
  id            Int                @id @default(autoincrement())
  assistenciaId Int
  assistencia   AssistenciaReuniao @relation(fields: [assistenciaId], references: [id], onDelete: Cascade)
  nome          String
  irmaoId       Int?
  irmao         Irmao?             @relation(fields: [irmaoId], references: [id], onDelete: SetNull)
  pessoas       Int                @default(1)
  levantouMao   Boolean            @default(false)
  createdAt     DateTime           @default(now())

  @@unique([assistenciaId, nome])
  @@index([irmaoId])
}

// Confirmacao das partes de estudante: o irmao/irma com parte disse se vai cumprir.
//
// Chaveada pela DATA + campo + nome, e NAO por SemanaReuniao — mesmo motivo da
// AssistenciaReuniao acima: reimportar o mes apaga e recria as semanas com ids novos, e uma
// confirmacao ja obtida nao pode se perder porque alguem reimportou o PDF.
//
// `nome` e o texto como esta na programacao, nao uma chave estrangeira para Irmao: boa parte
// das irmas das partes do ministerio nao esta no cadastro, que gira em torno das funcoes
// mecanicas. Casar com o cadastro (para pegar o telefone) e feito por semelhanca de nome, na
// leitura, e nao aqui.
model ConfirmacaoDesignacao {
  id        Int      @id @default(autoincrement())
  data      String // "dd/MM/yyyy" — o dia da reuniao de meio de semana
  campo     String // "tesouro3_principal", "ministerio1_salaB", ...
  nome      String // nome como esta na programacao importada
  confirmou Boolean? // null = ainda sem resposta, true = vai cumprir, false = nao vai
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([data, campo, nome])
}

// ==========================================================================
// CARRINHO DE PUBLICAÇÕES
// ==========================================================================
// Os turnos do carrinho sao FIXOS e se repetem toda semana — nao ha quadro
// mensal como nas outras areas. Por isso a escala e modelada como
// (ponto -> turno semanal -> pessoas), e nao por data.
//
// O cadastro de pessoas e proprio, separado de `Irmao`: a maioria e irma, o
// vinculo nao tem relacao com funcoes de reuniao ou saida de campo, e a lista
// e mantida por quem cuida do carrinho. Misturar as duas obrigaria a inventar
// funcoes que nao existem no cadastro principal.
//
// O `telefone` existe para a automacao de lembretes (n8n + Evolution API) que
// sera ligada depois: com dia da semana e hora do turno, da para consultar quem
// serve e disparar a mensagem sem precisar de mais nenhuma tabela.

model CarrinhoPonto {
  id        Int             @id @default(autoincrement())
  nome      String          @unique // "Ex Combatentes", "KM 17"
  cor       String          @default("#8A8071") // cor do cabecalho na planilha de origem
  ativo     Boolean         @default(true)
  ordem     Int             @default(0)
  turnos    CarrinhoTurno[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model CarrinhoPublicador {
  id        Int              @id @default(autoincrement())
  nome      String           @unique
  telefone  String? // formato livre; a automacao normaliza na hora de enviar
  ativo     Boolean          @default(true)
  escalas   CarrinhoEscala[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model CarrinhoTurno {
  id         Int              @id @default(autoincrement())
  pontoId    Int
  ponto      CarrinhoPonto    @relation(fields: [pontoId], references: [id], onDelete: Cascade)
  diaSemana  Int // 0 = domingo ... 6 = sabado, igual ao Date.getDay()
  horaInicio String // "06:00"
  horaFim    String // "08:00"
  escalas    CarrinhoEscala[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([pontoId, diaSemana, horaInicio])
}

// EM TRANSICAO: `irmaoId` e o destino, `publicadorId` e a origem.
//
// As pessoas viviam em duas tabelas — Irmao (quem tem funcao mecanica, so homens) e
// CarrinhoPublicador (quem faz carrinho, homens e mulheres) — e quem estava nas duas existia
// duas vezes, com telefone podendo divergir. A unificacao move todo mundo para Irmao.
//
// Os dois campos convivem de proposito: acrescentar coluna e seguro no `db push` do
// EasyPanel, remover trava o deploy. Depois que a migracao for conferida em producao,
// `publicadorId` e a tabela CarrinhoPublicador saem num passo separado.
model CarrinhoEscala {
  id           Int                 @id @default(autoincrement())
  turnoId      Int
  turno        CarrinhoTurno       @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  publicadorId Int?
  publicador   CarrinhoPublicador? @relation(fields: [publicadorId], references: [id], onDelete: Cascade)
  irmaoId      Int?
  irmao        Irmao?              @relation(fields: [irmaoId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())
  // A UNIQUE de (turnoId, irmaoId) NAO entra aqui ainda, e isso e deliberado.
  //
  // A producao aplica o schema com `prisma db push` (comando do painel do EasyPanel), e ele
  // RECUSA criar constraint UNIQUE sem --accept-data-loss: ele nao confere se ha duplicata,
  // so avisa que poderia haver. Como o comando de boot e encadeado com `&&`, o `npm start`
  // nunca e alcancado e o container reinicia em loop — foi o que derrubou a API em
  // 2026-08-27.
  //
  // A protecao contra o mesmo irmao duas vezes no mesmo turno continua valendo pela UNIQUE de
  // cima enquanto `publicadorId` existir. Quando a unificacao terminar, a de irmaoId entra
  // assim: rodar a SQL a mao uma vez no console do Postgres
  //     CREATE UNIQUE INDEX "CarrinhoEscala_turnoId_irmaoId_key" ON "CarrinhoEscala"("turnoId","irmaoId");
  // e SO ENTAO reintroduzir a linha aqui — com o indice ja existindo, o db push acha schema e
  // banco iguais e o boot passa.

  @@unique([turnoId, publicadorId])
}

// Configuração das Saídas de Campo (locais/horários por dia da semana)
model SaidaCampo {
  id                    Int                   @id @default(autoincrement())
  diaSemana             String // "segunda", "terca", "quarta", "quinta", "sexta", "sabado"
  turno                 Int                   @default(1) // 1 para dias normais, 1-4 para sábado
  local                 String // "Ex-Combatentes - Casa dos irmãos Wagner e Odete"
  horario               String // "08:45"
  ativo                 Boolean               @default(true)
  dirigentesDisponiveis DirigenteSaidaCampo[]
  escalas               EscalaDirigente[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

// Relação N:N - Quais irmãos podem dirigir em cada saída de campo
model DirigenteSaidaCampo {
  id           Int        @id @default(autoincrement())
  irmaoId      Int
  irmao        Irmao      @relation(fields: [irmaoId], references: [id], onDelete: Cascade)
  saidaCampoId Int
  saidaCampo   SaidaCampo @relation(fields: [saidaCampoId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([irmaoId, saidaCampoId])
}

// Quadro mensal da Escala de Dirigentes
model QuadroDirigente {
  id             Int               @id @default(autoincrement())
  mes            Int // 1-12
  ano            Int // 2026
  titulo         String
  status         String            @default("rascunho")
  // Igual ao Quadro acima. Aqui NAO ha de onde preencher para tras: a escala de dirigentes
  // nunca escreveu no Historico (que so tem FK para Quadro), entao a medicao comeca do dia
  // em que esta coluna passou a ser gravada — e o painel diz isso em vez de mostrar zero.
  publicadoEm    DateTime?
  publicadoPorId Int?
  publicadoPor   Usuario?          @relation("EscalasPublicadas", fields: [publicadoPorId], references: [id], onDelete: SetNull)
  escalas        EscalaDirigente[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([mes, ano])
}

// Escala: cada dia/saída tem um unico dirigente. O papel de substituto foi
// extinto, entao nao ha mais um segundo nome por turno.
model EscalaDirigente {
  id           Int             @id @default(autoincrement())
  quadroId     Int
  quadro       QuadroDirigente @relation(fields: [quadroId], references: [id], onDelete: Cascade)
  saidaCampoId Int
  saidaCampo   SaidaCampo      @relation(fields: [saidaCampoId], references: [id], onDelete: Cascade)
  data         String // "02/06" (dia/mês)
  dia          String // "Segunda", "Terça", etc.
  principal    String          @default("") // Nome do dirigente
  removido     Boolean         @default(false) // Para remover dias/semanas
  // null = nao avaliado, true = dirigiu a saida, false = faltou. Trocar o
  // dirigente (edicao manual ou regerar) zera a avaliacao — ela e da
  // escalacao anterior, nao do nome que entra.
  cumpriu      Boolean?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// ==========================================================================
// NOTIFICACOES PUSH
// ==========================================================================

// Aparelhos que recebem push. A chave e o `token`, nao o usuario: um mesmo
// aparelho pode trocar de dono (logout/login) e um mesmo irmao pode ter varios
// aparelhos, entao o vinculo e reatribuido no upsert por token.
// Cascade porque token de conta apagada nao serve para mais nada.
model PushToken {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  token     String   @unique // ExponentPushToken[...]
  platform  String? // "ios" | "android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Trava de idempotencia do lembrete. Se o container reiniciar depois de um disparo, o
// agendador roda de novo e sem o unique abaixo isso viraria push repetido no celular de
// todo mundo a cada restart.
//
// `regra` entra na chave porque o irmao pode pedir mais de uma antecedencia para o MESMO
// dia ("1 semana antes" e "1 dia antes"): sem ela, o primeiro lembrete travaria o segundo.
model LembreteEnviado {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  dataISO   String // dia das designacoes lembradas (YYYY-MM-DD)
  regra     String   @default("1d") // id da regra de antecedencia (ver RegrasLembrete)
  createdAt DateTime @default(now())

  @@unique([usuarioId, dataISO, regra])
}

// Copia de cada push enviado, POR USUARIO (nao por aparelho). E daqui que o app
// reconstroi a central de notificacoes: o listener local so roda com o app aberto
// ou quando o irmao TOCA na notificacao — um push que chega com o app fechado e e
// dispensado da bandeja sumiria sem esta tabela. Criada ANTES do envio para o id
// viajar no payload (`data.notifId`) e o app desduplicar com o registro local.
model NotificacaoEnviada {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo    String
  corpo     String
  data      Json?
  createdAt DateTime @default(now())

  @@index([usuarioId, createdAt])
}

// O que cada irmao quer receber. Sem linha aqui vale o padrao (todos os tipos, so "1 dia
// antes"), que e exatamente o comportamento que existia antes desta tela: quem nunca abrir
// as configuracoes nao percebe diferenca nenhuma.
model PreferenciaNotificacao {
  id            Int      @id @default(autoincrement())
  usuarioId     Int      @unique
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipos         String[] // "designacao" | "dirigente" | "reuniao"
  antecedencias String[] // ids de RegrasLembrete: "7d", "3d", "1d", "3h", "1h"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==========================================================================
// TAREFAS DO SISTEMA
// ==========================================================================

// O que o admin geral pos no colo de cada irmao: mandar o link do Zoom, montar o
// quadro, fazer as confirmacoes, compartilhar o quadro no grupo.
//
// E uma tabela separada de `Usuario.escopos` porque as duas coisas nao sao a mesma:
// escopo e PERMISSAO (onde a pessoa pode mexer), tarefa e RESPONSABILIDADE (o que ela
// tem de fazer, e ate quando). Quem manda o link do Zoom nao administra area nenhuma,
// e quem administra as reunioes nao necessariamente e quem manda o link.
//
// Nao guarda prazo nem ocorrencia: o "quando" de cada tarefa e DERIVADO da programacao
// importada e dos quadros (ver services/RegrasTarefas.js). Gravar as ocorrencias aqui
// significaria criar linha para cada semana de cada irmao e mante-las em dia a cada
// reimportacao do mes — que e justamente o que apaga e recria as semanas.
model TarefaDesignada {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // Ver TIPOS em src/services/RegrasTarefas.js.
  tipo      String
  createdAt DateTime @default(now())

  // Uma linha por tarefa por irmao: a mesma tarefa pode ser de varios irmaos, mas o
  // mesmo irmao nao acumula a mesma tarefa duas vezes.
  @@unique([usuarioId, tipo])
  @@index([tipo])
}

// O check da tarefa: esta OCORRENCIA desta tarefa deste irmao esta cumprida.
//
// `ocorrencia` e sempre uma data ISO (YYYY-MM-DD) e identifica de qual repeticao se
// fala — a reuniao (tarefa por reuniao), a reuniao de meio de semana que representa a
// semana (tarefa semanal) ou o dia 1o do mes alvo (tarefa mensal). Data, e nao o id da
// SemanaReuniao, pelo mesmo motivo de AssistenciaReuniao e ConfirmacaoDesignacao:
// reimportar o mes recria as semanas com ids novos, e um "ja fiz" nao pode se perder
// porque alguem reimportou o PDF.
//
// As tarefas de quadro NAO passam por aqui: elas se dao por cumpridas quando o quadro
// do mes seguinte e PUBLICADO (ver RegrasTarefas.CONCLUSAO_AUTOMATICA). Um botao de
// "concluir" ali deixaria o irmao silenciar um prazo sem ter feito o quadro.
model TarefaConcluida {
  id          Int      @id @default(autoincrement())
  usuarioId   Int
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo        String
  ocorrencia  String
  concluidoEm DateTime @default(now())

  @@unique([usuarioId, tipo, ocorrencia])
  @@index([usuarioId, tipo])
}

// ==========================================================================
// TERRITORIOS
// ==========================================================================
// Os poligonos nascem no Google My Maps da congregacao: cada CAMADA de um mapa e um
// territorio, cada POLIGONO da camada e uma quadra. O app importa o KML publico do mapa
// (ver services/MyMapsService.js) e o "Atualizar do My Maps" casa de novo por (mymapsMid,
// mymapsCamada) — o My Maps continua sendo onde se desenha.
//
// Os cartoes em imagem (backend/public/territorios) continuam valendo como "cartao original",
// casados pelo `numero`.
model Territorio {
  id           Int                    @id @default(autoincrement())
  // Texto, e nao Int, porque ha territorio "06A". Unico: e por ele que a tela abre.
  numero       String                 @unique
  nome         String
  // Agrupamento livre ("Tokaia", "KM 17") para a lista.
  area         String?
  // Outros nomes pelos quais o territorio e conhecido, para a busca. Separados por virgula.
  apelidos     String?
  observacoes  String?
  cor          String?
  mymapsMid    String?
  mymapsCamada String?
  // Inicio do ciclo atual: so o que foi registrado depois disto conta para a situacao
  // (concluido / em andamento). "Novo ciclo" move esta data; o historico fica.
  cicloDesde   DateTime               @default(now())
  // Confirmado pelo responsavel: este territorio nao sera iniciado neste ciclo.
  naoIniciado  Boolean                @default(false)
  ativo        Boolean                @default(true)
  quadras      Quadra[]
  saidas       RegistroSaida[]
  marcacoes    Marcacao[]
  designacoes  DesignacaoTerritorio[]
  avisos       AvisoTerritorio[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([mymapsMid, mymapsCamada])
}

model Quadra {
  id           Int             @id @default(autoincrement())
  territorioId Int
  territorio   Territorio      @relation(fields: [territorioId], references: [id], onDelete: Cascade)
  nome         String
  cor          String?
  // [[lat, lng], ...] — o contorno, como veio do My Maps.
  pontos       Json
  ordem        Int             @default(0)
  ativo        Boolean         @default(true)
  saidas       RegistroSaida[]
  marcacoes    Marcacao[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// Uma saida de campo no territorio: concluiu, ou onde parou.
//
// `clientKey` e gerado no CELULAR: a saida pode ser registrada sem internet e reenviada
// depois, e o mesmo envio chegando duas vezes nao pode virar dois registros.
model RegistroSaida {
  id             Int        @id @default(autoincrement())
  clientKey      String     @unique
  territorioId   Int
  territorio     Territorio @relation(fields: [territorioId], references: [id], onDelete: Cascade)
  // Parte do territorio de que se fala; null = o territorio inteiro.
  quadraId       Int?
  quadra         Quadra?    @relation(fields: [quadraId], references: [id], onDelete: SetNull)
  autorId        Int?
  autor          Usuario?   @relation("SaidasTerritorio", fields: [autorId], references: [id], onDelete: SetNull)
  dia            String // YYYY-MM-DD, no fuso da congregacao
  concluiu       Boolean    @default(false)
  ondeParou      String?
  // "sim" (continuar na proxima casa) | "nao" (comecar nesta) | "incerto" | "outro_lugar"
  casaTrabalhada String?
  proximoInicio  String?
  pendente       String?
  lat            Float?
  lng            Float?
  // "ativa" | "conflito" (outro dirigente registrou a mesma parte no mesmo dia) | "descartada"
  status         String     @default("ativa")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([territorioId, dia])
}

// Um ponto no mapa, marcado pelo GPS (ou tocando no mapa).
//
// "Nao bater" mora aqui tambem: e um ponto com texto ("Rua X, 120") que precisa ser
// reconfirmado a cada 3 meses. lat/lng sao opcionais so por ele — da para registrar a casa
// pelo endereco quando o GPS nao ajuda.
model Marcacao {
  id                Int        @id @default(autoincrement())
  clientKey         String     @unique
  territorioId      Int
  territorio        Territorio @relation(fields: [territorioId], references: [id], onDelete: Cascade)
  quadraId          Int?
  quadra            Quadra?    @relation(fields: [quadraId], references: [id], onDelete: SetNull)
  autorId           Int?
  autor             Usuario?   @relation("MarcacoesTerritorio", fields: [autorId], references: [id], onDelete: SetNull)
  // "parada" | "proximo" | "concluido" | "nao_bater" | "observacao"
  tipo              String
  lat               Float?
  lng               Float?
  // Raio de incerteza do GPS em metros, como o aparelho informou.
  precisao          Float?
  texto             String?
  // Hora do aparelho: a marcacao feita sem internet chega ao servidor depois.
  marcadaEm         DateTime
  ativo             Boolean    @default(true)
  reconfirmadaEm    DateTime?
  reconfirmadaPorId Int?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([territorioId, ativo])
}

// Quem leva o territorio em qual dia. `irmaoId` e o dirigente no cadastro — e por ele que a
// designacao aparece em "Minhas designacoes" e entra nos lembretes de saida de campo.
model DesignacaoTerritorio {
  id           Int        @id @default(autoincrement())
  territorioId Int
  territorio   Territorio @relation(fields: [territorioId], references: [id], onDelete: Cascade)
  irmaoId      Int
  irmao        Irmao      @relation(fields: [irmaoId], references: [id], onDelete: Cascade)
  dia          String // YYYY-MM-DD
  // Dia em que o territorio inteiro foi concluido nesta designacao (vai para o S-13).
  concluidoEm  String?
  criadoPorId  Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([dia])
  @@index([territorioId])
}

// Aviso fixo do territorio: "acesso impedido", "entrar pela outra rua"...
model AvisoTerritorio {
  id           Int        @id @default(autoincrement())
  territorioId Int
  territorio   Territorio @relation(fields: [territorioId], references: [id], onDelete: Cascade)
  // "acesso_impedido" | "entrada_outra_rua" | "trecho_pendente" | "outro"
  tipo         String
  texto        String
  ativo        Boolean    @default(true)
  criadoPorId  Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ==========================================================================
// RELATORIO DE SERVICO DE CAMPO
// ==========================================================================

// O relatorio de um irmao num mes de servico, anotado pelo dirigente (ou ajudante) do grupo
// dele no comeco do mes seguinte. Publicador: participou ou nao, e quantos estudos. Pioneiro
// (regular pelo cadastro, ou auxiliar naquele mes): horas e estudos.
model RelatorioCampo {
  id               Int      @id @default(autoincrement())
  irmaoId          Int
  irmao            Irmao    @relation(fields: [irmaoId], references: [id], onDelete: Cascade)
  // "2026-10": o mes em que o servico foi feito (entregue no inicio de novembro).
  mes              String
  participou       Boolean  @default(false)
  estudos          Int      @default(0)
  // So de quem foi pioneiro no mes. Inteiro, como no relatorio.
  horas            Int?
  pioneiroAuxiliar Boolean  @default(false)
  // Regular quando relatou: o cadastro pode mudar depois, o relatorio nao.
  pioneiroRegular  Boolean  @default(false)
  observacao       String?
  // O grupo em que o irmao estava ao relatar: se ele mudar de grupo, o relatorio fica onde foi feito.
  grupoId          Int?
  registradoPorId  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([irmaoId, mes])
  @@index([mes])
}

// O grupo entregou o relatorio do mes inteiro (todos os membros). Existe para avisar o
// secretario uma vez so e para a tela mostrar quando o grupo concluiu.
model RelatorioGrupoMes {
  id          Int        @id @default(autoincrement())
  grupoId     Int
  grupo       GrupoCampo @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  mes         String
  concluidoEm DateTime   @default(now())

  @@unique([grupoId, mes])
}

// ==========================================================================
// INTEGRACAO COM O ZOOM (webhooks + API REST, Server-to-Server OAuth)
// ==========================================================================

// Uma OCORRENCIA de reuniao do Zoom. A chave e o UUID: a reuniao recorrente repete o numero
// (meetingId) toda semana, e cada ocorrencia ganha o seu UUID.
model ZoomReuniao {
  id               Int                 @id @default(autoincrement())
  uuid             String              @unique
  meetingId        String
  accountId        String?
  hostId           String?
  hostEmail        String?
  topico           String?
  inicio           DateTime?
  fim              DateTime?
  duracaoMin       Int?
  fuso             String?
  // Resumo do AI Companion. `resumoMarkdown` e o summary_content como veio, sem mexer;
  // `resumoBruto` e a resposta inteira da API, para rastrear o que foi recebido.
  resumoTitulo     String?
  resumoMarkdown   String?
  resumoBruto      Json?
  resumoEditadoEm  DateTime?
  resumoDocUrl     String?
  // Tirado do Markdown (e dos campos antigos da API) para a tela: [{ titulo, itens }] e [texto].
  topicos          Json?
  decisoes         Json?
  proximosPassos   Json?
  transcricao      String?
  transcricaoBruta Json?
  participantesQtd Int?
  // Quando todas as partes chegaram a um estado final (ok, indisponivel ou erro).
  sincronizadoEm   DateTime?
  participantes    ZoomParticipante[]
  sincronizacoes   ZoomSincronizacao[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([inicio])
  @@index([meetingId])
}

// Uma entrada na reuniao, como vem do relatorio de participantes: quem sai e volta aparece
// de novo (outro user_id). `irmaoId` e o casamento do nome com o cadastro, quando ha certeza.
model ZoomParticipante {
  id             Int         @id @default(autoincrement())
  reuniaoId      Int
  reuniao        ZoomReuniao @relation(fields: [reuniaoId], references: [id], onDelete: Cascade)
  zoomUserId     String?
  participanteId String?
  nome           String
  entrada        DateTime?
  saida          DateTime?
  duracaoSeg     Int?
  status         String?
  irmaoId        Int?
  irmao          Irmao?      @relation(fields: [irmaoId], references: [id], onDelete: SetNull)

  @@index([reuniaoId])
}

// A fila: uma linha por reuniao e por parte ("detalhes", "resumo", "participantes",
// "transcricao"). O processamento pega o que esta pendente e venceu `proximaTentativa`;
// falha temporaria (429, 5xx, rede, relatorio ainda nao pronto) volta com espera crescente.
model ZoomSincronizacao {
  id               Int         @id @default(autoincrement())
  reuniaoId        Int
  reuniao          ZoomReuniao @relation(fields: [reuniaoId], references: [id], onDelete: Cascade)
  parte            String
  // pendente | ok | indisponivel (o Zoom nao tem: resumo desligado, sem transcricao) | erro
  status           String      @default("pendente")
  tentativas       Int         @default(0)
  proximaTentativa DateTime    @default(now())
  ultimoErro       String?
  concluidaEm      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([reuniaoId, parte])
  @@index([status, proximaTentativa])
}

// Cada evento recebido do Zoom, gravado ANTES de processar (nao se perde se o processamento
// cair). `chave` (evento + UUID + horario do evento) segura a repeticao: o Zoom reenvia o
// mesmo evento quando nao recebe resposta a tempo.
model ZoomEvento {
  id          Int       @id @default(autoincrement())
  chave       String    @unique
  evento      String
  meetingUuid String?
  meetingId   String?
  accountId   String?
  payload     Json
  // recebido | aplicado | ignorado
  status      String    @default("recebido")
  ultimoErro  String?
  recebidoEm  DateTime  @default(now())
  aplicadoEm  DateTime?

  @@index([status])
  @@index([meetingUuid])
}

// ==========================================================================
// AREA DE PIONEIROS: o ministerio que o proprio pioneiro registra
// ==========================================================================
// No servidor, e nao so no celular: trocar ou perder o aparelho nao perde nada. Cada um ve
// so o que e seu (o pioneiro regular e o admin geral usam a area).

// A meta do mes e o cronometro. O cronometro e do servidor: comecar no celular e parar no
// outro aparelho funciona, e fechar o app nao zera.
model PioneiroPerfil {
  irmaoId          Int       @id
  irmao            Irmao     @relation(fields: [irmaoId], references: [id], onDelete: Cascade)
  // Horas por mes (o ano de servico e 12x isso).
  metaMensal       Int       @default(50)
  // Rodando desde (null = parado ou pausado) e o que ja somou antes das pausas.
  cronometroInicio DateTime?
  cronometroSeg    Int       @default(0)
  updatedAt        DateTime  @updatedAt
}

// Horas de ministerio: cada parada do cronometro ou cada lancamento a mao.
model PioneiroHoras {
  id         Int      @id @default(autoincrement())
  irmaoId    Int
  irmao      Irmao    @relation(fields: [irmaoId], references: [id], onDelete: Cascade)
  // "2026-10-23": o dia, no relogio da congregacao.
  data       String
  minutos    Int
  // manual | cronometro
  origem     String   @default("manual")
  observacao String?
  createdAt  DateTime @default(now())

  @@index([irmaoId, data])
}

// Quem o pioneiro visita de novo (e os estudos biblicos: `estudo` ligado).
model Revisita {
  id            Int              @id @default(autoincrement())
  irmaoId       Int
  irmao         Irmao            @relation(fields: [irmaoId], references: [id], onDelete: Cascade)
  nome          String
  endereco      String?
  lat           Float?
  lng           Float?
  telefone      String?
  observacao    String?
  estudo        Boolean          @default(false)
  ativa         Boolean          @default(true)
  // A proxima visita marcada e quando o aviso dela foi mandado (null = ainda nao).
  proximaVisita DateTime?
  lembreteEm    DateTime?
  visitas       RevisitaVisita[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([irmaoId])
  @@index([proximaVisita])
}

model RevisitaVisita {
  id         Int      @id @default(autoincrement())
  revisitaId Int
  revisita   Revisita @relation(fields: [revisitaId], references: [id], onDelete: Cascade)
  data       DateTime
  observacao String?
  createdAt  DateTime @default(now())

  @@index([revisitaId])
}

