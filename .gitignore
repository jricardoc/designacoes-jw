# Ignorar tudo por padrão
*

# Manter arquivos essenciais
!README.md
!EASYPANEL.md
!.gitignore
!.easignore
!docker-compose.yml
!docker-compose.prod.yml
!Caddyfile
!.env.example
!LICENSE
!docs/
!docs/**
!.github/
!.github/**

# Manter pastas backend e frontend
!backend/
!backend/**
!frontend/
!frontend/**

# Manter pasta mobile (app React Native / Expo)
!mobile/
!mobile/**

# Ignorar node_modules e builds dentro das pastas
backend/node_modules/
backend/dist/
frontend/node_modules/
frontend/dist/
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/dist-check/
mobile/expo-env.d.ts

# NUNCA versionar chaves de service account do Firebase/Google (segredo!)
mobile/*-firebase-adminsdk-*.json
mobile/*service-account*.json
mobile/google-service-account*.json

# Config do Firebase do cliente — contém API key; fornecer via EAS secret no build
mobile/google-services.json
mobile/GoogleService-Info.plist

# Mapas de territorio sao de cada congregacao: em producao vivem num volume montado em
# /app/public/territorios (ver docs/INSTALACAO.md), nunca no repositorio publico.
backend/public/territorios/

# Ignorar arquivos de ambiente (manter .env.example)
.env
backend/.env
frontend/.env
.DS_Store
Reorganização de layout A4/
# Planilhas de origem do carrinho (so a pasta da raiz).
# A barra inicial e essencial: sem ela o padrao casa QUALQUER pasta chamada carrinho,
# e com core.ignorecase=true no Windows ele engoliu frontend/src/pages/Carrinho/ —
# os modais novos nunca chegaram a ser commitados e o build quebrou no deploy.
/carrinho/
