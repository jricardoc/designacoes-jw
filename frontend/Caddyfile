:80 {
    # Links curtos para instalar o app (servirmais.site/download/android e /ios).
    # Vão para a API, que redireciona para o build mais recente guardado no banco pelo webhook
    # do EAS: um build novo vale sozinho, sem mexer aqui.
    redir /download/android* https://api.servirmais.site/download/android 302
    redir /download/ios/instalar https://api.servirmais.site/download/ios 302
    # /download/ios é a página com o passo a passo (public/download/ios.html).
    @ios path /download/ios /download/ios/
    rewrite @ios /download/ios.html

    root * /app/dist
    try_files {path} /index.html
    file_server
}
